<resources>
    <color name="bg">#FF0E0F13</color>
    <color name="accent">#FFFF6B4A</color>

    <style name="WatchTheme" parent="android:Theme.DeviceDefault">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <!-- The ringing screen can't be swiped away: finish the mission on your phone. -->
    <style name="WatchAlarmTheme" parent="WatchTheme">
        <item name="android:windowSwipeToDismiss">false</item>
    </style>
</resources>
